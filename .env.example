# 五项必填；速度单位 MB/s，延迟单位 ms
MIN_SPEED=5
MAX_LATENCY=200
ALIYUN_DOMAIN=cf.example.com
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 测速配置：可用 --download-number / --download-url 覆盖
DOWNLOAD_NUMBER=10
DOWNLOAD_URL=https://download.parallels.com/desktop/v17/17.1.1-51537/ParallelsDesktop-17.1.1-51537.dmg
# 其他可选设置
# 默认读取程序所在目录的 cfst、ip.txt，状态也写到程序目录
# DATA_DIR=/opt/cfip-ddns
# CFST_TIMEOUT=6h
# CHECK_INTERVAL=15m
# DNS_TTL=600
